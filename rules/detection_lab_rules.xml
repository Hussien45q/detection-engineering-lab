<!--
  Detection Engineering Lab - custom Wazuh rules
  Author: Hussien Kassem
  Source: Sysmon Event ID 1 (process creation) forwarded by the Wazuh agent
  Install: /var/ossec/etc/rules/detection_lab_rules.xml  (owner wazuh:wazuh, mode 660)
  Rule ID range reserved for this lab: 100100 - 100199
-->

<group name="local_detections,sysmon,attack,">

  <!-- T1059.001 - PowerShell launched with a Base64-encoded command -->
  <rule id="100100" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-e[a-z]*\s+[A-Za-z0-9+/=]{20,}</field>
    <description>Encoded PowerShell command executed on $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- T1105 - certutil used to download a file (LOLBin) -->
  <rule id="100101" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\certutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(urlcache|verifyctl).*(https?|ftp)://</field>
    <description>certutil used to download a remote file on $(win.system.computer)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <!-- T1136.001 - Local account created from the command line -->
  <rule id="100102" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\net1?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\suser\s.*\s/add</field>
    <description>Local user account created with net user /add on $(win.system.computer)</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <!-- T1053.005 - Scheduled task created with schtasks -->
  <rule id="100103" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s/create\s</field>
    <description>Scheduled task created with schtasks on $(win.system.computer)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- T1003.001 - LSASS memory dump attempt via comsvcs.dll MiniDump -->
  <rule id="100104" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)comsvcs(\.dll)?[\s,]+#?(minidump|24)\b</field>
    <description>Possible LSASS credential dump via comsvcs.dll MiniDump on $(win.system.computer)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

  <!-- T1070.001 - Windows event log cleared with wevtutil -->
  <rule id="100105" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\wevtutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s(cl|clear-log)\s</field>
    <description>Event log clear attempted with wevtutil on $(win.system.computer)</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
  </rule>

</group>
