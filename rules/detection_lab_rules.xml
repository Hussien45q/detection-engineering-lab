<!--
  Detection Engineering Lab - custom Wazuh rules
  Author: Hussien Kassem
  Source: Sysmon Event ID 1 (process creation) forwarded by the Wazuh agent
  Install: /var/ossec/etc/rules/detection_lab_rules.xml  (owner wazuh:wazuh, mode 660)
  Rule ID range reserved for this lab: 100100 - 100199
-->

<group name="local_detections,sysmon,attack,">

  <!-- T1059.001 - PowerShell launched with a Base64-encoded command -->
  <rule id="100100" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-e[a-z]*\s+[A-Za-z0-9+/=]{20,}</field>
    <description>Encoded PowerShell command executed on $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- T1059.001 (companion) - built-in rule 92057 claims encoded PowerShell launched
       from another PowerShell process first, so 100100 never sees that event.
       Chaining to 92057 with if_sid makes the lab rule fire in that case too. -->
  <rule id="100106" level="12">
    <if_sid>92057</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-e[a-z]*\s+[A-Za-z0-9+/=]{20,}</field>
    <description>Encoded PowerShell command executed on $(win.system.computer) (chained to built-in 92057)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- T1105 - certutil used to download a file (LOLBin) -->
  <rule id="100101" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\certutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(urlcache|verifyctl).*(https?|ftp)://</field>
    <description>certutil used to download a remote file on $(win.system.computer)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <!-- T1136.001 - Local account created from the command line -->
  <rule id="100102" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\net1?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\suser\s.*\s/add</field>
    <description>Local user account created with net user /add on $(win.system.computer)</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <!-- T1053.005 - Scheduled task created with schtasks -->
  <rule id="100103" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s/create\s</field>
    <description>Scheduled task created with schtasks on $(win.system.computer)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- T1003.001 - LSASS memory dump attempt via comsvcs.dll MiniDump -->
  <rule id="100104" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)comsvcs(\.dll)?[\s,]+#?(minidump|24)\b</field>
    <description>Possible LSASS credential dump via comsvcs.dll MiniDump on $(win.system.computer)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

  <!-- T1070.001 - Windows event log cleared with wevtutil -->
  <rule id="100105" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\wevtutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s(cl|clear-log)\s</field>
    <description>Event log clear attempted with wevtutil on $(win.system.computer)</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
  </rule>

  <!-- ===================== Week 3 ===================== -->

  <!-- T1033 - Account discovery: whoami asking for groups or privileges -->
  <rule id="100107" level="6">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\whoami\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s/(all|priv|groups)\b</field>
    <description>Discovery: whoami used to list groups or privileges on $(win.system.computer)</description>
    <mitre>
      <id>T1033</id>
    </mitre>
    <group>lab_discovery,</group>
  </rule>

  <!-- T1069.001 - Permission group discovery: listing local administrators -->
  <rule id="100108" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\net1?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\slocalgroup\s+"?administrators</field>
    <description>Discovery: local Administrators group listed with net on $(win.system.computer)</description>
    <mitre>
      <id>T1069.001</id>
    </mitre>
    <group>lab_discovery,</group>
  </rule>

  <!-- T1547.001 - Run key persistence pointing to a user-writable folder.
       Built-in rule 92300 matches Run key changes but is level 0 (no alert),
       so this child rule raises an alert when the new entry points somewhere
       attackers commonly drop files. Backslashes arrive doubled in Wazuh's
       eventchannel fields, hence \\+ . -->
  <rule id="100109" level="12">
    <if_sid>92300</if_sid>
    <field name="win.eventdata.details" type="pcre2">(?i)\\+(users\\+public|appdata|temp|programdata)\\+</field>
    <description>Persistence: Run key entry points to a user-writable folder on $(win.system.computer)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!-- ===================== Week 4 ===================== -->

  <!-- Correlation - several discovery commands on the same host in a short time.
       One whoami is normal admin work; a burst of them together with group
       enumeration is what an intruder does right after landing on a machine. -->
  <rule id="100110" level="12" frequency="3" timeframe="120">
    <if_matched_group>lab_discovery</if_matched_group>
    <same_location />
    <description>Discovery burst: 3+ discovery commands within 2 minutes on the same host</description>
    <mitre>
      <id>T1033</id>
      <id>T1069.001</id>
    </mitre>
  </rule>

</group>

<!-- Agent health. A silent agent is a blind spot (Week 3, finding 6), and stopping
     the security agent is a classic defense-evasion step. Built-in rules 504/506
     only alert at level 3, so these children raise them. -->
<group name="local_detections,agent_health,">

  <!-- Agent stopped (graceful service stop) - T1562.001 Impair Defenses -->
  <rule id="100112" level="10">
    <if_sid>506</if_sid>
    <description>Wazuh agent stopped on an endpoint - possible defense evasion or maintenance</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

  <!-- Agent disconnected (stopped reporting) -->
  <rule id="100111" level="10">
    <if_sid>504</if_sid>
    <description>Wazuh agent disconnected - endpoint is no longer reporting (visibility gap)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

</group>
